generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id        String        @id @default(cuid())
  guestName String
  email     String
  phone     String?
  roomType  String
  checkIn   DateTime
  checkOut  DateTime
  guests    Int
  message   String?
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}
